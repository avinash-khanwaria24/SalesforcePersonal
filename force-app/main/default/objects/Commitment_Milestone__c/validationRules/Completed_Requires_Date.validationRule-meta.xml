<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_Requires_Date</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status__c, "Completed") &amp;&amp; ISBLANK(Completed_Date__c)</errorConditionFormula>
    <errorDisplayField>Completed_Date__c</errorDisplayField>
    <errorMessage>Completed Date is required when Status is Completed.</errorMessage>
</ValidationRule>
