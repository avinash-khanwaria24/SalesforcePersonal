<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Signed_Requires_POD</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status__c, "Signed") &amp;&amp; Proof_of_Delivery__c = FALSE</errorConditionFormula>
    <errorDisplayField>Proof_of_Delivery__c</errorDisplayField>
    <errorMessage>Proof of Delivery must be checked when Status is Signed.</errorMessage>
</ValidationRule>
