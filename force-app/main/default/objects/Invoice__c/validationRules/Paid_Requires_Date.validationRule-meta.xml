<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Paid_Requires_Date</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status__c, "Paid") &amp;&amp; ISBLANK(Paid_Date__c)</errorConditionFormula>
    <errorDisplayField>Paid_Date__c</errorDisplayField>
    <errorMessage>Paid Date is required when Status is Paid.</errorMessage>
</ValidationRule>
