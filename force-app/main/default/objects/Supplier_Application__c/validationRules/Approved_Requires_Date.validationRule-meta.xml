<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Approved_Requires_Date</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status__c, "Approved") &amp;&amp; ISBLANK(Approved_Date__c)</errorConditionFormula>
    <errorDisplayField>Approved_Date__c</errorDisplayField>
    <errorMessage>Approved Date is required when Status is Approved.</errorMessage>
</ValidationRule>
